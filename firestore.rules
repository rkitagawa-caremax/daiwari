rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in [
          'y.goto@g.caremax.co.jp',
          'y.goto@caremax.co.jp',
          'k.ogura@g.caremax.co.jp',
          'k.ogura@caremax.co.jp',
          'k.matsue@g.caremax.co.jp',
          'k.matsue@caremax.co.jp',
          'k.okubo@g.caremax.co.jp',
          'k.okubo@caremax.co.jp',
          'k.ishihara@g.caremax.co.jp',
          'k.ishihara@caremax.co.jp',
          's.uhara@g.caremax.co.jp',
          's.uhara@caremax.co.jp',
          's.ozaki@g.caremax.co.jp',
          's.ozaki@caremax.co.jp',
          'r.kitagawa@g.caremax.co.jp',
          'r.kitagawa@caremax.co.jp'
        ];
    }

    // Shared workspace data
    match /artifacts/{appId}/public/data/{document=**} {
      allow read, write: if isAllowedGoogleUser();
    }

    // Account activity logs: all allowed users can view the dashboard,
    // but each account can only create/update its own immutable daily log.
    match /artifacts/{appId}/activityLogs/{logId} {
      allow read: if isAllowedGoogleUser();
      allow create: if isAllowedGoogleUser()
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'dateKey', 'totalActiveMs',
          'sessionCount', 'actionStats', 'lastSeenAt', 'version'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.totalActiveMs is int
        && request.resource.data.totalActiveMs >= 0
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount >= 0
        && request.resource.data.actionStats is map
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.version == 1;
      allow update: if isAllowedGoogleUser()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.dateKey == resource.data.dateKey
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'totalActiveMs', 'sessionCount',
          'actionStats', 'lastSeenAt', 'version'
        ])
        && request.resource.data.totalActiveMs is int
        && request.resource.data.totalActiveMs >= resource.data.totalActiveMs
        && request.resource.data.sessionCount is int
        && request.resource.data.sessionCount >= resource.data.sessionCount
        && request.resource.data.actionStats is map
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.version == 1;
      allow delete: if false;
    }

    // Per-account private workspace data
    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read, write: if isAllowedGoogleUser() && request.auth.uid == userId;
    }
  }
}
